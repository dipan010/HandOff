{
    "manifest_version": 3,
    "name": "HandOff",
    "version": "1.0",
    "description": "HandOff works in your browser tab for you: it reads the page, and clicks and types where you ask.",
    "permissions": [
        "tabs",
        "scripting",
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "overlay.js",
                "page_map.js",
                "content_script.js"
            ],
            "all_frames": true,
            "match_about_blank": true
        }
    ],
    "action": {
        "default_title": "HandOff"
    }
}
